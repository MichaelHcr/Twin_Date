# Copy this file to .env.local and fill in the values.
# Supabase: Dashboard > Project Settings > API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (Dashboard > Project Settings > API Keys > Secret keys).
# Server-only: bypasses row-level security. Never NEXT_PUBLIC_, never commit it.
SUPABASE_SECRET_KEY=

# Anthropic: console.anthropic.com > API Keys. Server-only, never NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Stripe, test mode only: dashboard.stripe.com (Test mode on) > Developers > API keys.
# Server-only, never NEXT_PUBLIC_. Test keys start with sk_test_.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_...): Developers > Webhooks, or the
# one `stripe listen` prints when testing locally.
STRIPE_WEBHOOK_SECRET=
